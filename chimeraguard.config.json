{
  "$schema": "https://chimera-guard.vercel.app/schema.json",
  "version": "1.5.0",
  "scope": {
    "strictMode": false,
    "allowlist": [
      "localhost",
      "127.0.0.1",
      "staging.yourdomain.com",
      "*.yourdomain.com"
    ],
    "blocklist": [
      "*.gov.br",
      "*.mil.br",
      "*.jus.br"
    ]
  },
  "ai": {
    "enabled": false,
    "provider": "offline",
    "budget": {
      "maxRequestsPerHour": 50,
      "cacheTtlSeconds": 259200
    }
  }
}
